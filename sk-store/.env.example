# Copy to .env for local work (never commit the real .env). On Vercel, set these in Settings > Environment Variables.
DATABASE_URL=postgres://user:password@host:5432/skstore

# Owner bootstrap - used ONCE, on the first build, when no owner exists yet. Minimum 10 characters.
# After the owner account exists, DELETE OWNER_PASSWORD from the environment settings.
OWNER_EMAIL=you@example.co.za
OWNER_NAME=Store Owner
OWNER_PASSWORD=choose-a-strong-password

# Public site URL, used to build reset/invitation links. REQUIRED in production.
APP_BASE_URL=http://localhost:3000

# Email: 'resend' in production. 'console' prints links in the server log - local testing only.
# In production with no provider set, reset emails are not sent (and no links are logged).
EMAIL_PROVIDER=console
EMAIL_FROM=Sancho Kimberly <no-reply@yourdomain.co.za>
EMAIL_API_KEY=

# Payments. Without these, checkout shows "payment not available" in production (by design: no unpaid orders).
# PAYMENT_PROVIDER=payfast needs the three values below (from your PayFast account). Untested against real PayFast.
PAYMENT_PROVIDER=
PAYMENT_GATEWAY_KEY=        # PayFast merchant id
PAYMENT_GATEWAY_SECRET=     # PayFast merchant key
PAYMENT_WEBHOOK_SECRET=     # PayFast passphrase (also signs mock payments)
PAYFAST_SANDBOX=true
# Testing only. Never set in production with real customers:
# PAYMENT_PROVIDER=mock
# ALLOW_TEST_PAYMENTS=yes_no_real_money

# Optional fallback for the store name in emails. The Owner > Settings page value is used first.
STORE_NAME=

# AI customer assistant (Stage 3). All optional: without a provider/key the
# assistant answers from its fixed store answers at no cost.
# AI_PROVIDER: openai | nvidia | gemini | anthropic
AI_PROVIDER=
# One or more API keys, comma-separated. Extra keys are used for failover/rotation.
# Alternatively add NVIDIA/Gemini keys from Owner > AI assistant (encrypted server-side).
# Dashboard keys take priority per pool; removing all restores the environment pool.
AI_API_KEYS=
# Optional overrides: AI_MODEL=, AI_BASE_URL= (self-hosted/provider-compatible endpoint)
# NVIDIA: AI_PROVIDER=nvidia, AI_MODEL=meta/llama-3.1-70b-instruct
# Defaults to https://integrate.api.nvidia.com; AI_BASE_URL can also end in /v1.
# Optional automatic Gemini backup, active ONLY when AI_PROVIDER=nvidia.
# Keep NVIDIA keys in AI_API_KEYS; never mix Google's keys into that value.
# One or more Google Gemini keys, comma-separated. Empty disables backup.
GEMINI_API_KEYS=
# Backup-only overrides. They never inherit the primary AI_MODEL/AI_BASE_URL.
# Defaults: GEMINI_MODEL=gemini-2.5-flash
#           GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Each request tries up to 2 primary keys, then up to 2 backup keys.
# If both providers fail, the existing fixed store answers remain available.
# Test-only mock provider. Yes enables a fake provider for automated tests; keep unset otherwise.
# ALLOW_TEST_AI=yes_no_real_cost

# Required ONLY for encrypted dashboard key management, not environment-only setup.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable, private and backed up. Never add NEXT_PUBLIC_. Redeploy after setting it.
AI_KEY_ENCRYPTION_SECRET=

# Shared ceiling for guest assistant messages per rolling 24 hours.
# Cookie changes cannot reset this ceiling or per-IP message budgets.
AI_GUEST_DAILY_MAX=1000
